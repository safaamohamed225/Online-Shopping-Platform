@model Category

@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "Category Details";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}
@{
    string plainText = System.Text.RegularExpressions.Regex
        .Replace(Model.Description ?? "", "<.*?>", string.Empty);
}


<div>
    <h4>Category</h4>
    <hr />
    <input type="hidden" asp-for="Id" />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @plainText
        </dd>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedTime)
        </dt>
        <dd class="col-sm-10">
            @Model.CreatedTime.ToString("yyyy-MM-dd HH:mm")
        </dd>
    </dl>
</div>

<a asp-action="Index" asp-controller="Category" class="btn btn-secondary">Back to List</a>
