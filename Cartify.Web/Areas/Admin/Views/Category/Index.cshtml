@model IEnumerable<Category>


@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "Categories List";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div>
    <a asp-action="Create" class="btn btn-success">Create New Category</a>
</div>
<br />
<table class ="table table-hover" width="100%">
    <thead class="text-bold">
    <tr>
        <td>Name</td>
        <td>Description</td>
        <td>Created Time</td>
        <td>Actions</td>
    </tr>
    </thead>
    @foreach (var category in Model)
    {
        <tr>
            <td>@category.Name</td>
            <td> @Html.Raw(category.Description)</td>
            <td>@category.CreatedTime</td>
            <td>
                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-primary">Edit</a>
                <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
</table>