@model IEnumerable<ApplicationUser>

    @{
    ViewData["Title"] = "User Management";
}

<div>
    <a href="/Identity/Account/Register" class="btn btn-success">Create New User</a>
</div>
<br />
<table class ="table table-hover" width="100%">
    <tr>
        <td>Name</td>
        <td>Email</td>
        <td>PhoneNumber</td>
        <td>Actions</td>
    </tr>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Name</td>
            <td>@user.Email</td>
            <td>@user.PhoneNumber</td>
            <td>
                @if(user.LockoutEnd == null || user.LockoutEnd < DateTime.Now)
                {
            
                    <a asp-action="LockUnLock" class="btn btn-info" asp-route-id = "@user.Id">
                        <i class="fas fa-lock-open"></i>
                    </a>
                }
                else
                {
                    <a asp-action="LockUnLock" class="btn btn-warning" asp-route-id="@user.Id">
                        <i class="fas fa-lock"></i>
                    </a>
                }
                <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
</table>