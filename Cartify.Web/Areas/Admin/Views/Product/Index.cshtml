@model IEnumerable<Product>


@{
    ViewBag.PageTitle = "Product Management";
    ViewBag.CardTitle = "Products List";
}

<div>
    <a asp-action="Create" asp-controller="Product" class="btn btn-success">Create New Product</a>
</div>
<br />
<table id="DT_load" class="table table-hover" width="100%">
    <thead class="text-bold">
    <tr>
        <td>Name</td>
        <td>Description</td>
        <td>Price</td>
        <td>Category</td>
        <td>Actions</td>
    </tr>
    </thead>
</table>

@section Scripts
{
    <script src="~/js/products.js"></script>
}
