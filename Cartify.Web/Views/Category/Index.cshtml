@model IEnumerable<Category>
@{
    ViewData["Title"] = "Categories";
}

<table class ="table table-hover" width="100%">
    <tr>
        <td>Name</td>
        <td>Description</td>
        <td>Created Time</td>
    </tr>
    @foreach (var category in Model)
    {
        <tr>
            <td>@category.Name</td>
            <td>@category.Description</td>
            <td>@category.CreatedTime.ToString("g")</td>
        </tr>
    }
</table>